+/**
+ * Map a range of indices to promises with a bounded number of concurrent
+ * executions. Used while deserializing project targets so that a project with
+ * many sprites doesn't trigger an unbounded burst of simultaneous asset
+ * uploads / decodes on the main thread.
+ * @param {number} count - number of items to process
+ * @param {function(number): Promise} worker - returns the promise for index i
+ * @param {number} [limit=4] - maximum number of workers in flight
+ * @returns {Promise<Array>} array of resolved results, ordered by index
+ */
+const mapWithConcurrency = function (count, worker, limit = 4) {
+    if (count === 0) return Promise.resolve([]);
+    const results = new Array(count);
+    let nextIndex = 0;
+    let active = 0;
+    return new Promise((resolve, reject) => {
+        const startNext = () => {
+            // Pull up to `limit` workers at a time, keeping the event loop
+            // free enough for other scheduled work (rendering, audio, UI).
+            while (active < limit && nextIndex < count) {
+                const i = nextIndex++;
+                active++;
+                Promise.resolve()
+                    .then(() => worker(i))
+                    .then(value => {
+                        results[i] = value;
+                        active--;
+                        if (nextIndex < count) {
+                            startNext();
+                        } else if (active === 0) {
+                            resolve(results);
+                        }
+                    }, error => {
+                        reject(error);
+                    });
+            }
+        };
+        startNext();
+    });
+};
